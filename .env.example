# Django
SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_VALUE
DEBUG=False

# Important: must match deployment domain/IP(s)
ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.local,your-server-ip
CSRF_TRUSTED_ORIGINS=http://your-domain.local,https://your-domain.local

# Static Files
STATIC_ROOT=/path/to/your/staticfiles/

# Database (used by both Django and Postgres service)
DB_NAME=mine_db
DB_USER=mine_user
DB_PASSWORD=change_me_strong_password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis
REDIS_URL=redis://redis:6379/0

# Email Settings
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
DEFAULT_FROM_EMAIL=Project Name <your_email@gmail.com>

# Project-specific
ESP32_API_KEY=CHANGE_ME_ESP32_KEY

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60