+  window.addEventListener("unload", function (evt) {
+    window.dismissChildPopups();
+  });
+
+  $(document).ready(function () {
+    setPopupIndex();
+    $("a[data-popup-opener]").on("click", function (event) {
+      event.preventDefault();
+      opener.dismissRelatedLookupPopup(window, $(this).data("popup-opener"));
+    });
+    $("body").on(
+      "click",
+      '.related-widget-wrapper-link[data-popup="yes"]',
+      function (e) {
+        e.preventDefault();
+        if (this.href) {
+          const event = $.Event("django:show-related", { href: this.href });
+          $(this).trigger(event);
+          if (!event.isDefaultPrevented()) {
+            showRelatedObjectPopup(this);
+          }
+        }
+      }
+    );
+    $("body").on("change", ".related-widget-wrapper select", function (e) {
+      const event = $.Event("django:update-related");
+      $(this).trigger(event);
+      if (!event.isDefaultPrevented()) {
+        updateRelatedObjectLinks(this);
+      }
+    });
+    $(".related-widget-wrapper select").trigger("change");
+    $("body").on("click", ".related-lookup", function (e) {
+      e.preventDefault();
+      const event = $.Event("django:lookup-related");
+      $(this).trigger(event);
+      if (!event.isDefaultPrevented()) {
+        showRelatedObjectLookupPopup(this);
+      }
     });
+  });
 }
diff --git a/static/diploma/css/main.css b/static/diploma/css/main.css
index 4360179..0effa10 100644
--- a/static/diploma/css/main.css
+++ b/static/diploma/css/main.css
@@ -26,4 +26,86 @@
 @import 'pages/mine_map.css';
 @import 'pages/diploma_home.css';
 @import 'pages/personnel.css';
-@import 'pages/equipment.css';
\ No newline at end of file
+@import 'pages/equipment.css';
+
+/* ===== 5. ОПТИМІЗАЦІЯ ДЛЯ ВЕЛИКИХ ДИСПЛЕЇВ (Ultrawide / 4K) ===== */
+@media (min-width: 1920px) {
+    /* Обмежуємо ширину контенту всюди, окрім сторінки карти шахти */
+    body:not(.mine-map-page) .dashboard-main .container-fluid,
+    body:not(.mine-map-page) .dashboard-header .container-fluid {
+        max-width: 1800px;
+        margin: 0 auto;
+    }
+}
+
+/* ===== 6. ОПТИМІЗАЦІЯ ДЛЯ ПЛАНШЕТІВ ТА СЕНСОРНИХ ЕКРАНІВ ===== */
+@media (hover: none) and (pointer: coarse) {
+    /* Усуваємо "залипання" hover-ефектів після тапу пальцем на планшеті */
+    .status-card:hover, .alert-item:hover, .employee-card:hover, .btn-action:hover {
+        transform: none !important;
+    }
+    .status-card:active, .alert-item:active, .employee-card:active, .btn-action:active {
+        transform: scale(0.98) !important; /* Залишаємо лише ефект фізичного натискання (провалювання) */
+    }
+}
+
+/* ===== 7. ПРИМУСОВА ГОРИЗОНТАЛЬНА ОРІЄНТАЦІЯ ===== */
+.orientation-warning {
+    display: none;
+    position: fixed;
+    bottom: 20px; left: 50%;
+    transform: translateX(-50%);
+    background: rgba(15, 15, 21, 0.9);
+    border: 1px solid #4dabf7;
+    border-radius: 12px;
+    z-index: 9999;
+    color: #fff;
+    align-items: center;
+    padding: 12px 20px;
+    backdrop-filter: blur(10px);
+    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
+    pointer-events: none; /* КРИТИЧНО ВАЖЛИВО: Пропускає всі кліки крізь себе! */
+    gap: 15px;
+}
+
+.orientation-warning .rotate-icon {
+    font-size: 24px;
+    color: #4dabf7;
+    animation: rotateDevice 2s infinite ease-in-out;
+}
+
+@keyframes rotateDevice {
+    0% { transform: rotate(0deg); }
+    50% { transform: rotate(-90deg); }
+    100% { transform: rotate(0deg); }
+}
+
+/* Показуємо попередження лише на мобільних і планшетах у вертикальному (портретному) положенні */
+@media screen and (max-width: 1024px) and (orientation: portrait) {
+    .orientation-warning {
+        display: flex;
+    }
+}
+
+/* ===== 8. БАНЕР ВТРАТИ ЗВ'ЯЗКУ (OFFLINE) ===== */
+.offline-banner {
+    position: fixed;
+    top: 0; left: 0; right: 0;
+    background: #ef4444;
+    color: #fff;
+    text-align: center;
+    padding: 8px;
+    font-weight: 600;
+    font-size: 13px;
+    z-index: 100000;
+    display: flex;
+    justify-content: center;
+    align-items: center;
+    gap: 10px;
+    transform: translateY(-100%);
+    transition: transform 0.3s ease;
+    box-shadow: 0 4px 15px rgba(239, 68, 68, 0.5);
+}
+.offline-banner.active {
+    transform: translateY(0);
+}
\ No newline at end of file
diff --git a/static/diploma/css/pages/mine_map.css b/static/diploma/css/pages/mine_map.css
index ec23c15..f329fcc 100644
--- a/static/diploma/css/pages/mine_map.css
